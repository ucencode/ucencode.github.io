---
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
---
<BaseLayout>
  <main class="home">
    <BentoGrid />
  </main>
</BaseLayout>

<style>
  .home {
    box-sizing: border-box;
    padding: var(--page-pad);
  }
  @media (min-width: 1200px) {
    .home {
      display: grid;
      justify-items: center;
      align-content: start;
    }
  }
</style>
