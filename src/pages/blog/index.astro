---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { profile } from '@/data/about';
import { sections } from '@/data/sections';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout
  width="64rem"
  title={`Blog — ${profile.name}`}
  description={sections.blog.metaDescription}
>
  <div class="pt-12">
    <div>
      <p class="font-mono text-primary text-sm mb-3 tracking-wide">{sections.blog.label}</p>
      <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-4">
        {sections.blog.title}
      </h1>
      <p class="text-muted-foreground max-w-lg mb-12">
        {sections.blog.intro}
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-muted-foreground">{sections.blog.emptyText}</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, index) => (
          <BlogCard post={post} index={index} reveal={false} />
        ))}
      </div>
    )}
  </div>
</PageLayout>
