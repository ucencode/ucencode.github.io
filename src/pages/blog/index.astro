---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.tsx';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';
import { profile } from '@/data/about';
import { sections } from '@/data/sections';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Blog — ${profile.name}`}
  description={sections.blog.metaDescription}
>
  <Header client:load />
  <main class="max-w-5xl mx-auto px-6 py-24 md:py-32">
    <div>
      <p class="font-mono text-primary text-sm mb-3 tracking-wide">{sections.blog.label}</p>
      <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-4">
        {sections.blog.title}
      </h1>
      <p class="text-muted-foreground max-w-lg mb-12">
        {sections.blog.intro}
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-muted-foreground">{sections.blog.emptyText}</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, index) => (
          <BlogCard post={post} index={index} reveal={false} />
        ))}
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>
