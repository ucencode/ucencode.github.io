---
import { ExternalLink } from 'lucide-react';
import PageLayout from '../../layouts/PageLayout.astro';
import ImageViewer from '../../components/ImageViewer.tsx';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { profile } from '@/data/about';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { entry, prev, next } = Astro.props;
const project = entry.data;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
// Fall back to the first figure in the body when the project has no card image.
// Figure paths are relative to src/content/projects/, so resolve them to the built asset.
const figureImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{webp,png,jpg,jpeg}', { eager: true });
const firstFigure = entry.body?.match(/!\[[^\]]*\]\(([^\s)]+)/)?.[1];
const firstFigureKey = firstFigure && new URL(firstFigure, 'file:///src/content/projects/').pathname;
const ogImage = project.image?.src.src ?? (firstFigureKey ? figureImages[firstFigureKey]?.default.src : undefined);
---

<PageLayout
  width="48rem"
  title={`${project.title} — ${profile.name}`}
  description={project.description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={project.image?.alt ?? `${project.title} preview`}
>
  <div class="pt-12">

    <nav class="flex items-center justify-between mb-10 text-sm">
      <a href={`${base}projects/`} class="text-muted-foreground hover:text-primary transition-colors">← All projects</a>
      <div class="flex items-center gap-2">
        {prev && (
          <a href={`${base}projects/${prev.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            ← Previous
          </a>
        )}
        {next && (
          <a href={`${base}projects/${next.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            Next →
          </a>
        )}
      </div>
    </nav>

    <header>
      <p class="font-mono text-xs text-primary mb-2 tracking-wide uppercase">Project</p>
      <h1 class="text-3xl font-semibold text-foreground">{project.title}</h1>
      <p class="mt-3 text-muted-foreground leading-relaxed">{project.description}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        {project.projectStack.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>

      {project.links.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
          {project.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-primary hover:opacity-80 transition-opacity font-medium"
            >
              <ExternalLink size={14} />
              {link.label}
            </a>
          ))}
        </div>
      )}
    </header>

    <article
      data-figures
      class="mt-12 prose prose-invert max-w-none
        prose-headings:font-semibold prose-headings:text-foreground
        prose-h2:font-mono prose-h2:text-xs prose-h2:text-primary prose-h2:tracking-wide prose-h2:uppercase prose-h2:mt-10 prose-h2:mb-3
        prose-p:text-muted-foreground prose-p:leading-relaxed
        prose-li:text-muted-foreground prose-li:leading-relaxed prose-li:marker:text-primary
        prose-a:text-primary prose-a:no-underline hover:prose-a:underline
        prose-strong:text-foreground
        prose-figure:my-8 prose-img:rounded-xl prose-img:border prose-img:border-border prose-img:cursor-zoom-in prose-img:w-full
        prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:text-muted-foreground">
      <Content />
    </article>

    <ImageViewer client:idle />

    <nav class="flex items-center justify-between mt-16 pt-8 border-t border-border text-sm">
      <a href={`${base}projects/`} class="text-muted-foreground hover:text-primary transition-colors">← All projects</a>
      <div class="flex items-center gap-2">
        {prev && (
          <a href={`${base}projects/${prev.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            ← {prev.data.title}
          </a>
        )}
        {next && (
          <a href={`${base}projects/${next.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            {next.data.title} →
          </a>
        )}
      </div>
    </nav>

  </div>
</PageLayout>
