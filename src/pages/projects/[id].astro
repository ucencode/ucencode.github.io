---
import { ExternalLink } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.astro';
import ProjectSlides from '../../components/ProjectSlides.tsx';
import { projects, type Project } from '@/data/projects';
import { profile } from '@/data/about';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const ogImage = project.image?.src ?? project.slides[0]?.path;
---

<BaseLayout
  title={`${project.title} — ${profile.name}`}
  description={project.description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={project.image?.alt ?? `${project.title} preview`}
>
  <Header client:load />
  <main class="max-w-3xl mx-auto px-6 py-24">

    <nav class="flex items-center justify-between mb-10 text-sm">
      <a href={`${base}#projects`} class="text-muted-foreground hover:text-primary transition-colors">← All projects</a>
      <div class="flex items-center gap-2">
        {prev && (
          <a href={`${base}projects/${prev.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            ← Previous
          </a>
        )}
        {next && (
          <a href={`${base}projects/${next.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            Next →
          </a>
        )}
      </div>
    </nav>

    <header>
      <p class="font-mono text-xs text-primary mb-2 tracking-wide uppercase">Project</p>
      <h1 class="text-3xl font-semibold text-foreground">{project.title}</h1>
      <p class="mt-3 text-muted-foreground leading-relaxed">{project.description}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        {project.projectStack.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>

      {project.links && project.links.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
          {project.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-primary hover:opacity-80 transition-opacity font-medium"
            >
              <ExternalLink size={14} />
              {link.label}
            </a>
          ))}
        </div>
      )}
    </header>

    {project.slides.length > 0 && (
      <div class="mt-10">
        <ProjectSlides client:visible title={project.title} slides={project.slides} />
      </div>
    )}

    {project.additionalInfo && project.additionalInfo.length > 0 && (
      <article class="mt-12 space-y-10">
        {project.additionalInfo.map((section) => (
          <section>
            <h2 class="font-mono text-xs text-primary mb-3 tracking-wide uppercase">{section.title}</h2>
            <ul class="space-y-2 list-disc pl-5 marker:text-primary">
              {section.bullets.map((bullet) => (
                <li class="text-muted-foreground leading-relaxed">{bullet}</li>
              ))}
            </ul>
          </section>
        ))}
      </article>
    )}

    <nav class="flex items-center justify-between mt-16 pt-8 border-t border-border text-sm">
      <a href={`${base}#projects`} class="text-muted-foreground hover:text-primary transition-colors">← All projects</a>
      <div class="flex items-center gap-2">
        {prev && (
          <a href={`${base}projects/${prev.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            ← {prev.title}
          </a>
        )}
        {next && (
          <a href={`${base}projects/${next.id}/`} class="px-4 py-2 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors duration-200">
            {next.title} →
          </a>
        )}
      </div>
    </nav>

  </main>
  <Footer />
</BaseLayout>
