---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { profile } from '@/data/about';
import { experience, experienceSummary } from '@/data/experience';

const projects = await getCollection('projects');
const projectRef = (id?: string) => {
  const p = id && projects.find((x) => x.id === id);
  return p ? { href: `/projects/${p.id}/`, label: `CS-${String(p.data.order).padStart(3, '0')} ${p.data.title}` } : null;
};
const years = experience.flatMap((e) => [Number(e.start.slice(0, 4)), Number(e.end.slice(0, 4))]);
const dates = (year: string) => year.replace(' - ', ' – ');
---
<PageLayout title={`Experience — ${profile.name}`} description={experienceSummary.subtitle}>
  <PageHeader
    title="Work history"
    lead={experienceSummary.subtitle}
    group="lavender"
    meta={[
      { term: 'roles', value: String(experience.length) },
      { term: 'span', value: `${Math.min(...years)} – ${Math.max(...years)}` },
      { term: 'status', value: 'open to roles', accent: true },
    ]}
    cv
  />

  <figure class="fig">
    <ExperienceTimeline detailed />
    <figcaption>fig. 1 — roles over time (PITCAR was freelance, alongside Indokoding and NoscAi)</figcaption>
  </figure>

  {experience.map((role, i) => {
    const ref = projectRef(role.project);
    return (
      <section class="role" aria-labelledby={`r${i}`}>
        <div class="when">
          <span class="dates">{dates(role.year)}</span>
          <span class="mode">{role.mode.toLowerCase()} · {role.duration}</span>
        </div>
        <div class="what">
          <div class="head">
            <h2 id={`r${i}`} class="headline-md">{role.position}</h2>
            <p class="company">{role.company}</p>
          </div>
          <ul>
            {role.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        {ref && (
          <aside class="note">see → <a href={ref.href}>{ref.label}</a></aside>
        )}
      </section>
    );
  })}
</PageLayout>

<style>
  .fig {
    margin: 0;
    padding: 40px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid var(--border);
  }
  figcaption {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--subtext);
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    padding: 44px 0;
    border-bottom: 1px solid var(--border);
  }
  .when {
    flex: 0 0 180px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  .dates {
    font-size: 13px;
    color: var(--lavender);
  }
  .mode {
    font-size: 12px;
    color: var(--subtext);
  }
  .what {
    flex: 999 1 480px;
    min-width: 0;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .head h2,
  .company {
    margin: 0;
  }
  .company {
    font-size: 15px;
    color: var(--subtext);
  }
  ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: disc;
    font-size: 16px;
    line-height: 1.65;
    color: var(--chip-text);
  }
  .note {
    flex: 1 1 180px;
    align-self: flex-start;
    padding-left: 14px;
    border-left: 1px solid var(--border);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    line-height: 1.6;
    color: var(--subtext);
  }
  .note a {
    color: var(--chip-text);
  }
</style>
