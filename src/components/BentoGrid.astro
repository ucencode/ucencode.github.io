---
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import ExperienceTimeline from './ExperienceTimeline.astro';
import { tiles, type TileId } from '@/data/tiles';
import { testimonials } from '@/data/testimonials';
import { socialLinks } from '@/data/about';
import { getPublishedPosts } from '@/lib/blog';

const posts = await getPublishedPosts();
const quote = testimonials[0];

const tile = (id: TileId) => tiles.find((t) => t.id === id)!;
const about = tile('about');
const work = tile('work');
const experience = tile('experience');
const blog = tile('blog');
const recs = tile('recommendations');
const contact = tile('contact');
const blogLine = `${posts.length} posts · ${blog.line}`;
---
<div class="hub">
  <div class="row row1">
  <a href={about.href} class="tile tile-about">
    <div class="tile-top">
      <span class="label" style="color: var(--peach)">{about.label}</span>
      <ArrowUpRight className="arrow" size={20} aria-hidden="true" />
    </div>
    <div class="tile-body">
      <h1 class="display-xl name">{about.title}</h1>
      <p class="role" style="color: var(--peach)">{about.line}</p>
    </div>
  </a>

  <a href={work.href} class="tile tile-work">
    <div class="tile-top">
      <span class="label" style="color: var(--lavender)">{work.label}</span>
      <ArrowUpRight className="arrow" size={20} aria-hidden="true" />
    </div>
    <div class="tile-body">
      <h2 class="headline-lg title">{work.title}</h2>
      <p class="line mono">{work.line}</p>
    </div>
  </a>

  <a href={experience.href} class="tile tile-experience">
    <div class="tile-top">
      <span class="label" style="color: var(--lavender)">{experience.label}</span>
      <ArrowUpRight className="arrow" size={20} aria-hidden="true" />
    </div>
    <div class="tile-body">
      <div class="visual"><ExperienceTimeline /></div>
      <h2 class="headline-md title">{experience.title}</h2>
      <p class="line">{experience.line}</p>
    </div>
  </a>
  </div>

  <div class="row row2">
  <a href={blog.href} class="tile tile-blog">
    <div class="tile-top">
      <span class="label" style="color: var(--lavender)">{blog.label}</span>
      <ArrowUpRight className="arrow" size={20} aria-hidden="true" />
    </div>
    <div class="tile-body">
      <h2 class="headline-md title">{blog.title}</h2>
      <p class="line mono">{blogLine}</p>
    </div>
  </a>

  <section class="tile tile-recs" aria-labelledby="tile-recs-h">
    <div class="tile-top">
      <h2 id="tile-recs-h" class="label" style="color: var(--mauve)">{recs.label}</h2>
      <span class="quote-mark" aria-hidden="true">“</span>
    </div>
    <blockquote class="visual quote">
      {quote.highlight.before}<span style="color: var(--mauve)">{quote.highlight.phrase}</span>{quote.highlight.after}”
    </blockquote>
    <div class="recs-foot">
      <span class="line by"><span class="by-name">{quote.name}</span> · {quote.title}</span>
      <a href="/recommendations/" class="recs-link">{recs.title} <ArrowRight size={14} aria-hidden="true" /></a>
    </div>
  </section>
  <a href="/recommendations/" class="tile tile-row-only">
    <div class="tile-top">
      <span class="label" style="color: var(--mauve)">{recs.label}</span>
      <ArrowUpRight className="arrow" size={20} aria-hidden="true" />
    </div>
    <div class="tile-body">
      <span class="title row-title">Recommendations</span>
      <p class="line">{testimonials.length} people</p>
    </div>
  </a>

  <section class="tile tile-contact" aria-labelledby="tile-contact-h">
    <div class="contact-head">
      <div class="contact-label"><span class="label" style="color: var(--peach)">{contact.label}</span></div>
      <h2 id="tile-contact-h" class="headline-md title">{contact.title}</h2>
      {contact.line && <p class="line">{contact.line}</p>}
    </div>
    <div class="contact-actions">
      <a href={`mailto:${socialLinks.email}`} class="btn-primary email"><span>Email me</span><ArrowRight size={18} aria-hidden="true" /></a>
      <div class="contact-row">
        <a href={socialLinks.linkedin} class="btn-secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={socialLinks.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
  </div>
</div>

<style>
  .hub {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }

  /* Tile base */
  .tile {
    container-type: inline-size;
    min-width: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 24px;
    border-radius: var(--radius-tile);
    background: var(--tile);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }
  a.tile {
    transition: border-color 150ms ease-out;
  }
  a.tile:hover {
    border-color: var(--border-strong);
  }
  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .label {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 400;
  }
  .arrow {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--subtext);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tile-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .title,
  .name {
    margin: 0;
  }
  .name {
    max-width: 9em;
  }
  .role {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 500;
  }
  .line {
    margin: 0;
    font-size: 14px;
    color: var(--subtext);
  }
  .mono {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
  }
  .tile-experience .visual {
    margin-bottom: 4px;
  }

  /* Recommendations */
  .quote-mark {
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 0.6;
    font-weight: 700;
    color: var(--mauve);
  }
  .quote {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }
  .recs-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px 16px;
  }
  .by {
    font-size: 13px;
  }
  .by-name {
    font-weight: 600;
    color: var(--text);
  }
  .recs-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    margin-bottom: -12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--chip-text);
    text-underline-offset: 4px;
  }
  .recs-link:hover {
    color: var(--text);
  }

  /* Contact */
  .contact-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .email {
    justify-content: space-between;
    padding: 0 20px;
  }
  .contact-row {
    display: flex;
    gap: 8px;
  }
  .contact-row > a {
    flex: 1 1 0;
    font-size: 14px;
    font-weight: 500;
  }

  /* A narrow tile keeps its label, title and arrow only. Phone rows always keep their line. */
  @media (min-width: 700px) {
    @container (max-width: 220px) {
      .line {
        display: none;
      }
    }
  }

  /* Phone: About block, then navigation rows */
  @media (max-width: 699px) {
    .tile-about {
      min-height: clamp(185px, 28vh, 240px);
    }
    /* Navigation rows: label, title and one line on the left, arrow on the right. */
    .tile:not(.tile-about) {
      height: 84px;
      padding: 0 16px;
    }
    .tile-work,
    .tile-experience,
    .tile-blog,
    .tile-row-only {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: 12px;
      row-gap: 2px;
    }
    .tile-work .tile-top,
    .tile-experience .tile-top,
    .tile-blog .tile-top,
    .tile-row-only .tile-top {
      display: contents;
    }
    .tile:not(.tile-about) .label {
      grid-column: 1;
      grid-row: 1;
    }
    .tile:not(.tile-about) .arrow {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
    }
    .tile:not(.tile-about) .tile-body {
      grid-column: 1;
      grid-row: 2;
      min-width: 0;
      gap: 2px;
    }
    .tile:not(.tile-about) .title {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .tile:not(.tile-about) .line {
      font-size: 13px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .visual {
      display: none;
    }
    /* The recommendations tile becomes a plain link row. */
    .tile-recs {
      display: none;
    }
    .tile.tile-contact {
      justify-content: center;
      gap: 6px;
    }
    .tile-contact .title,
    .tile-contact .line {
      display: none;
    }
    .tile-contact .contact-actions {
      flex-direction: row;
      gap: 6px;
    }
    .tile-contact .email {
      flex: 1 1 0;
      min-height: 44px;
      padding: 0 12px;
    }
    .tile-contact .email svg {
      display: none;
    }
    .contact-row {
      flex: 2 1 0;
      gap: 6px;
    }
    .contact-row > a {
      padding: 0 8px;
    }
  }

  @media (min-width: 700px) {
    .tile-row-only {
      display: none;
    }
  }

  /* Contact label row matches the label row of tiles with an arrow. */
  @media (min-width: 700px) and (max-width: 1199px) {
    .contact-head {
      gap: 16px;
    }
    .contact-label {
      display: flex;
      align-items: center;
      min-height: 20px;
    }
  }

  @media (max-width: 359px) {
    .tile:not(.tile-about) {
      height: 92px;
    }
  }

  /* Phone and tablet: the row wrappers drop out and tiles flow in DOM order. */
  .row {
    display: contents;
  }

  /* Tablet: two columns in pairs; the three rows share the viewport height. */
  @media (min-width: 700px) and (max-width: 1199px) {
    .hub {
      grid-template-columns: 1.2fr 1fr;
      grid-auto-rows: minmax(260px, 1fr);
      min-height: calc(100dvh - 2 * var(--page-pad));
    }
  }

  /* Desktop: two rows with their own column tracks, Blog in the corner.
     The hub fills the viewport up to 1920px wide and 900px tall. Below
     688px of height the page scrolls. Heading sizes follow the hub width
     and stop growing at their full size from a 1440px-wide hub. */
  @media (min-width: 1200px) {
    .hub {
      --hub-w: min(1920px, 100vw - 2 * var(--page-pad));
      --fs-display: min(64px, var(--hub-w) * 64 / 1440);
      --fs-headline-lg: min(48px, var(--hub-w) * 48 / 1440);
      --fs-headline-md: min(28px, var(--hub-w) * 28 / 1440);
      display: flex;
      flex-direction: column;
      width: min(1920px, 100%);
      height: clamp(688px, 100dvh - 2 * var(--page-pad), 900px);
    }
    .row {
      display: grid;
      flex: 1 1 0;
      min-height: 0;
      gap: var(--gap);
      grid-template-rows: minmax(0, 1fr);
    }
    .row1 {
      grid-template-columns: 4fr 5fr minmax(280px, 3fr);
    }
    .row2 {
      grid-template-columns: minmax(280px, 3fr) 3fr 4.4fr;
      grid-template-areas: "contact recs blog";
    }
    .tile-contact { grid-area: contact; }
    .tile-recs { grid-area: recs; }
    .tile-blog { grid-area: blog; }
  }
</style>
