---
import { ChevronLeft } from 'lucide-react';
import { routes } from '@/lib/routes';

const path = Astro.url.pathname;
const section = routes.find((r) => path.startsWith(r.href));
---
<header class="masthead">
  <a href="/" class="home-link">
    <ChevronLeft className="home-icon" size={16} aria-hidden="true" />
    <span>home</span>
  </a>
  <nav aria-label="Main" class="nav">
    {routes.map((r) => (
      <a
        href={r.href}
        class="nav-link"
        style={section?.href === r.href ? `color: var(--${r.group})` : undefined}
        aria-current={path === r.href ? 'page' : section?.href === r.href ? 'true' : undefined}
      >
        {r.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 24px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--subtext);
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    margin-left: -4px;
    color: var(--subtext);
    text-decoration: none;
  }
  .home-link:hover,
  .nav-link:hover {
    color: var(--text);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--subtext);
    text-decoration: none;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
</style>
