---
import { routes } from '@/lib/routes';

const path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);
const section = routes.find((r) => path.startsWith(r.href));
---
<header class="masthead">
  <div class="crumbs">
    <a href="/" aria-label="Home" class="crumb-link">~</a>
    {segments.map((seg, i) => {
      const href = '/' + segments.slice(0, i + 1).join('/') + '/';
      const last = i === segments.length - 1;
      return (
        <>
          <span class="crumb-sep" aria-hidden="true">/</span>
          {last ? (
            <span class="crumb-current" style={`color: var(--${section?.group ?? 'lavender'})`}>{seg}</span>
          ) : (
            <a href={href} class="crumb-link">{seg}</a>
          )}
        </>
      );
    })}
  </div>
  <nav aria-label="Main" class="nav">
    {routes.map((r) => (
      <a
        href={r.href}
        class="nav-link"
        style={section?.href === r.href ? `color: var(--${r.group})` : undefined}
        aria-current={path === r.href ? 'page' : section?.href === r.href ? 'true' : undefined}
      >
        {r.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 24px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--subtext);
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }
  .crumb-link,
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--subtext);
    text-decoration: none;
  }
  .crumb-link:hover,
  .nav-link:hover {
    color: var(--text);
  }
  .crumb-sep {
    color: var(--muted-bar);
  }
  .crumb-current {
    overflow-wrap: anywhere;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
</style>
