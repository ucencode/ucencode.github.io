---
import { ArrowUpRight } from 'lucide-react';
import { projects } from '@/data/projects';
import { sections } from '@/data/sections';

const base = import.meta.env.BASE_URL;
---

<section id="projects" class="py-24 md:py-32 section-alt">
  <div class="max-w-5xl mx-auto px-6">
    <div>
      <p class="font-mono text-primary text-sm mb-3 tracking-wide">
        {sections.projects.label}
      </p>
      <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-4">
        {sections.projects.title}
      </h2>
      <p class="text-muted-foreground max-w-lg mb-12">
        {sections.projects.intro}
      </p>
    </div>

    <div class="space-y-6">
      {projects.map((project, i) => {
        const isReversed = i % 2 !== 0;
        const imageSrc = project.image
          ? `${base}${project.image.src.replace(/^\//, '')}`
          : null;

        return (
          <a
            href={`${base}projects/${project.id}/`}
            class="group block w-full text-left bg-card border border-border rounded-xl overflow-hidden hover:border-primary/40 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background md:min-h-[280px]"
          >
            <div class:list={['flex flex-col md:flex-row md:items-stretch', isReversed && 'md:flex-row-reverse']}>
              <div class="relative w-full md:w-5/12 h-60 sm:h-64 md:h-auto md:min-h-[280px] overflow-hidden bg-secondary/40">
                {imageSrc && project.image && (
                  <>
                    <img
                      src={imageSrc}
                      alt={project.image.alt}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-tr from-black/35 via-transparent to-transparent opacity-70" />
                  </>
                )}
              </div>

              <div class="flex-1 p-6 md:p-7">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h3 class="font-semibold text-foreground text-base md:text-lg leading-snug group-hover:text-primary transition-colors">
                    {project.title}
                  </h3>
                  <span class="text-primary opacity-0 group-hover:opacity-100 transition-opacity mt-1">
                    <ArrowUpRight size={18} />
                  </span>
                </div>
                <p class="text-muted-foreground text-sm leading-relaxed mb-4 line-clamp-3">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {project.projectStack.slice(0, 3).map((tech) => (
                    <span class="tech-tag text-[11px]">{tech}</span>
                  ))}
                  {project.projectStack.length > 3 && (
                    <span class="tech-tag text-[11px]">+{project.projectStack.length - 3}</span>
                  )}
                </div>
                <p class="mt-5 text-sm font-medium text-primary">Read case study →</p>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
